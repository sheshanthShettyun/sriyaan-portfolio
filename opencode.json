{
  "$schema": "https://opencode.ai/config.json",
  "mcp": {
    "statekeeper": {
      "type": "local",
      "command": [
        "node",
        "/home/sriyaan/Documents/statekeeper-mcp/src/index.mjs"
      ],
      "enabled": true,
      "environment": {
        "STATEKEEPER_PROJECT": "/home/sriyaan/Documents/opencode sessions"
      }
    },
    "eraser": {
      "type": "http",
      "url": "https://app.eraser.io/api/mcp",
      "enabled": true
    },
    "figma": {
      "type": "remote",
      "url": "https://mcp.figma.com/mcp",
      "enabled": true
    },
    "lovable": {
      "type": "http",
      "url": "https://mcp.lovable.dev",
      "enabled": true
    },
    "colab-mcp": {
      "type": "local",
      "command": [
        "uvx",
        "git+https://github.com/googlecolab/colab-mcp"
      ],
      "enabled": true
    }
  }
}
